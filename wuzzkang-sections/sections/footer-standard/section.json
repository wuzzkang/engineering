{
  "id": "footer-standard",
  "namespace": "wuzzkang.core",
  "schemaVersion": "1.0.0",
  "displayName": "Footer Standard Section",
  "description": "Page footer with brand logo, quick navigation links list, and copyright notice.",
  "category": "footer",
  "tags": ["footer", "navigation", "copyright", "links"],
  "schema": [
    { "key": "copyrightText", "type": "text", "label": "Copyright Text", "required": true, "aiGeneratable": true },
    { "key": "footerLinks", "type": "list", "label": "Footer Links List", "required": false }
  ],
  "defaults": {
    "copyrightText": { "$type": "text", "value": "© 2026 WuzzKang Platform. Hak Cipta Dilindungi." },
    "footerLinks": {
      "$type": "list",
      "items": [
        { "$type": "text", "value": "Kebijakan Privasi" },
        { "$type": "text", "value": "Syarat & Ketentuan" },
        { "$type": "text", "value": "Pusat Bantuan" }
      ]
    }
  },
  "capabilities": {
    "supportsAIGeneration": true,
    "supportsAnimation": false,
    "supportsChildren": false,
    "responsiveBehavior": "fluid"
  }
}
