{
  "id": "header-nav",
  "namespace": "wuzzkang.core",
  "schemaVersion": "1.0.0",
  "displayName": "Header Navigation Bar",
  "description": "Top navigation bar with logo, customizable menu links list, and CTA button.",
  "category": "hero",
  "tags": ["header", "navigation", "menu"],
  "schema": [
    { "key": "logoText", "type": "text", "label": "Logo Text", "required": true, "aiGeneratable": true },
    { "key": "logoImage", "type": "image", "label": "Logo Image URL", "required": false },
    { "key": "navLinks", "type": "list", "label": "Navigation Links", "required": false },
    { "key": "ctaLabel", "type": "text", "label": "CTA Button Text", "required": false },
    { "key": "ctaUrl", "type": "url", "label": "CTA Link URL", "required": false }
  ],
  "defaults": {
    "logoText": { "$type": "text", "value": "WuzzKang" },
    "navLinks": {
      "$type": "list",
      "items": [
        { "$type": "text", "value": "Fitur" },
        { "$type": "text", "value": "Tentang" },
        { "$type": "text", "value": "Harga" },
        { "$type": "text", "value": "Kontak" }
      ]
    },
    "ctaLabel": { "$type": "text", "value": "Daftar Gratis" },
    "ctaUrl": { "$type": "url", "href": "https://wuzzkang.com/register" }
  },
  "capabilities": {
    "supportsAIGeneration": true,
    "supportsAnimation": false,
    "supportsChildren": false,
    "responsiveBehavior": "fluid"
  }
}
