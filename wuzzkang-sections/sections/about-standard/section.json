{
  "id": "about-standard",
  "namespace": "wuzzkang.core",
  "schemaVersion": "1.0.0",
  "displayName": "About Us Standard Section",
  "description": "Company biography with headline, rich text body, illustration image, and key metric stats list.",
  "category": "about",
  "tags": ["about", "company", "story", "stats"],
  "schema": [
    { "key": "headline", "type": "text", "label": "Headline", "required": true, "aiGeneratable": true },
    { "key": "bodyText", "type": "richtext", "label": "Body Description", "required": true, "aiGeneratable": true },
    { "key": "aboutImage", "type": "image", "label": "Company/Team Image", "required": false },
    { "key": "statsList", "type": "list", "label": "Key Metric Stats List", "required": false }
  ],
  "defaults": {
    "headline": { "$type": "text", "value": "Tentang WuzzKang" },
    "bodyText": { "$type": "text", "value": "WuzzKang dikembangkan untuk memberikan kebebasan penuh kepada pembuat website dalam menyusun landing page berbasis komponen modular yang efisien." },
    "statsList": {
      "$type": "list",
      "items": [
        { "$type": "text", "value": "10k+ User Aktif" },
        { "$type": "text", "value": "99.9% Uptime" },
        { "$type": "text", "value": "50+ Built-in Sections" }
      ]
    }
  },
  "capabilities": {
    "supportsAIGeneration": true,
    "supportsAnimation": true,
    "supportsChildren": false,
    "responsiveBehavior": "fluid"
  }
}
