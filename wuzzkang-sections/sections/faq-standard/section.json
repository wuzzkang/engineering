{
  "id": "faq-standard",
  "namespace": "wuzzkang.core",
  "schemaVersion": "1.0.0",
  "displayName": "FAQ Accordion Section",
  "description": "Frequently asked questions accordion list.",
  "category": "faq",
  "tags": ["faq", "accordion", "questions", "help"],
  "schema": [
    { "key": "title", "type": "text", "label": "Section Title", "required": true, "aiGeneratable": true },
    { "key": "items", "type": "list", "label": "FAQ Items List", "required": true }
  ],
  "defaults": {
    "title": { "$type": "text", "value": "Pertanyaan yang Sering Diajukan" },
    "items": {
      "$type": "list",
      "items": [
        { "$type": "text", "value": "Apakah WuzzKang V2 mendukung komponen custom?" },
        { "$type": "text", "value": "Ya, seluruh arsitektur berbasis section plugin modular." },
        { "$type": "text", "value": "Bagaimana cara melakukan publish?" },
        { "$type": "text", "value": "Cukup klik tombol Publish di editor, LP runtime akan otomatis revalidate." }
      ]
    }
  },
  "capabilities": {
    "supportsAIGeneration": true,
    "supportsAnimation": true,
    "supportsChildren": false,
    "responsiveBehavior": "fluid"
  }
}
