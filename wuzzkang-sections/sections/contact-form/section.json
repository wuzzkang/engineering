{
  "id": "contact-form",
  "namespace": "wuzzkang.core",
  "schemaVersion": "1.0.0",
  "displayName": "Contact Form Section",
  "description": "Lead generation contact form with inputs for name, email, message, and submit button.",
  "category": "contact",
  "tags": ["contact", "form", "lead", "email"],
  "schema": [
    { "key": "headline", "type": "text", "label": "Headline", "required": true, "aiGeneratable": true },
    { "key": "subheadline", "type": "text", "label": "Subheadline", "required": false, "aiGeneratable": true },
    { "key": "submitButtonText", "type": "text", "label": "Submit Button Label", "required": true },
    { "key": "submitEndpoint", "type": "url", "label": "Submit API Endpoint", "required": false }
  ],
  "defaults": {
    "headline": { "$type": "text", "value": "Hubungi Kami" },
    "subheadline": { "$type": "text", "value": "Kirim pesan Anda dan tim kami akan membalas dalam 24 jam." },
    "submitButtonText": { "$type": "text", "value": "Kirim Pesan" },
    "submitEndpoint": { "$type": "url", "href": "/api/v2/form-submit" }
  },
  "capabilities": {
    "supportsAIGeneration": true,
    "supportsAnimation": true,
    "supportsChildren": false,
    "responsiveBehavior": "fluid"
  }
}
