{
  "id": "features-grid",
  "namespace": "wuzzkang.core",
  "schemaVersion": "1.0.0",
  "displayName": "Features Grid Section",
  "description": "Grid layout showcasing key features with titles and descriptions.",
  "category": "features",
  "tags": ["features", "grid", "services"],
  "schema": [
    { "key": "headline", "type": "text", "label": "Section Headline", "required": true, "aiGeneratable": true },
    { "key": "subheadline", "type": "text", "label": "Section Subheadline", "required": false, "aiGeneratable": true },
    { "key": "featuresList", "type": "list", "label": "Features Items List", "required": true }
  ],
  "defaults": {
    "headline": { "$type": "text", "value": "Fitur Keunggulan WuzzKang" },
    "subheadline": { "$type": "text", "value": "Dirancang khusus untuk performa tinggi dan modularitas maksimal." },
    "featuresList": {
      "$type": "list",
      "items": [
        { "$type": "text", "value": "Modular Component System" },
        { "$type": "text", "value": "Real-time postMessage Canvas Sync" },
        { "$type": "text", "value": "W3C Three-Tier Design Tokens" },
        { "$type": "text", "value": "Framework-Agnostic Core Data Contract" }
      ]
    }
  },
  "capabilities": {
    "supportsAIGeneration": true,
    "supportsAnimation": true,
    "supportsChildren": false,
    "responsiveBehavior": "fluid"
  }
}
