{
  "id": "cta-centered",
  "namespace": "wuzzkang.core",
  "schemaVersion": "1.0.0",
  "displayName": "Centered Call To Action",
  "description": "High-converting centered banner with title, description, and primary CTA button.",
  "category": "contact",
  "tags": ["cta", "banner", "convert", "button"],
  "schema": [
    { "key": "headline", "type": "text", "label": "Headline", "required": true, "aiGeneratable": true },
    { "key": "subheadline", "type": "text", "label": "Subheadline", "required": false, "aiGeneratable": true },
    { "key": "ctaLabel", "type": "text", "label": "CTA Button Label", "required": true, "aiGeneratable": true },
    { "key": "ctaUrl", "type": "url", "label": "CTA URL", "required": true }
  ],
  "defaults": {
    "headline": { "$type": "text", "value": "Siap Mengubah Cara Anda Membangun Website?" },
    "subheadline": { "$type": "text", "value": "Mulai buat landing page cepat, modular, dan handal sekarang." },
    "ctaLabel": { "$type": "text", "value": "Coba Sekarang" },
    "ctaUrl": { "$type": "url", "href": "https://wuzzkang.com/register" }
  },
  "capabilities": {
    "supportsAIGeneration": true,
    "supportsAnimation": true,
    "supportsChildren": false,
    "responsiveBehavior": "fluid"
  }
}
